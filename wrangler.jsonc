{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hnfiltered-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "routes": [
    { "pattern": "hnfiltered.com", "custom_domain": true },
    { "pattern": "www.hnfiltered.com", "custom_domain": true },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "FILTER_MODE": "active",
    "OPENAI_MODEL": "gpt-5.6-luna",
  },
  "kv_namespaces": [
    {
      "binding": "VERDICTS",
      "id": "c0f6faafebbd49c9b2d2a4db9c33ecdb",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
